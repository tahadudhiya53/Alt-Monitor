{#
 # Craft's dashboard widget: coverage, then what needs attention, each linking to its list.
 #}
<div class="altmonitor-widget">
    {% if stats.audited == 0 %}
        <p class="light">{{ 'No images checked yet.'|t('alt-monitor') }}</p>
        {% if canOpen %}
            <a class="btn" href="{{ url('alt-monitor') }}">{{ 'Open AltMonitor'|t('alt-monitor') }}</a>
        {% endif %}
    {% else %}
        {% set coverage = stats.coverage() %}
        <p class="altmonitor-widget-coverage">
            <strong>{{ coverage ~ '%' }}</strong>
            <span class="light">{{ 'of {count, number} {count, plural, =1{image} other{images}} with no alt text problems found'|t('alt-monitor', {count: stats.audited}) }}</span>
        </p>
        <div class="altmonitor-progress altmonitor-progress--good" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ coverage }}" aria-label="{{ 'Alt text coverage'|t('alt-monitor') }}">
            <div style="width: {{ coverage }}%"></div>
        </div>

        <ul class="altmonitor-widget-counts">
            {% for row in [
                {status: 'missing', label: 'Missing alt text'|t('alt-monitor'), count: stats.missing, color: 'red'},
                {status: 'weak', label: 'Weak or generic'|t('alt-monitor'), count: stats.weak, color: 'orange'},
                {status: 'review', label: 'Needs review'|t('alt-monitor'), count: stats.review, color: 'blue'},
            ] %}
                {% set href = canOpen and row.count > 0 ? url('alt-monitor/images', {status: row.status}) : null %}
                <li>
                    <span class="status {{ row.color }}" aria-hidden="true"></span>
                    {% if href %}<a href="{{ href }}">{{ row.label }}</a>{% else %}{{ row.label }}{% endif %}
                    <span class="altmonitor-widget-count">{{ row.count|number }}</span>
                </li>
            {% endfor %}
        </ul>

        {% if stats.pendingSuggestions > 0 %}
            {% set label = '{count, number} {count, plural, =1{suggestion} other{suggestions}} to review'|t('alt-monitor', {count: stats.pendingSuggestions}) %}
            <p>{% if canOpen %}<a href="{{ url('alt-monitor/suggestions') }}">{{ label }}</a>{% else %}{{ label }}{% endif %}</p>
        {% endif %}

        <p class="smalltext light">
            {{ lastScan
                ? 'Last scan: {date}'|t('alt-monitor', {date: lastScan.completedAt|datetime('short')})
                : 'Not checked yet'|t('alt-monitor') }}
        </p>
    {% endif %}
</div>
