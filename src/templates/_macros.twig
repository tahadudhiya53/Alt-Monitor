{# Pieces the AltMonitor pages share. #}

{% macro altStatus(status) %}
    <span class="status-label {{ status.color() }}" data-alt-status="{{ status.value }}"><span class="status"></span><span class="status-label-text">{{ status.label() }}</span></span>
{% endmacro %}

{% macro suggestionStatus(suggestion) %}
    <span class="status-label {{ suggestion.status.color() }}" data-suggestion-status="{{ suggestion.status.value }}"><span class="status"></span><span class="status-label-text">{{ suggestion.status.label() }}</span></span>
{% endmacro %}

{% macro pagination(page, criteria, path, noun) %}
    {% if page.total > 0 %}
        <nav class="flex pagination" aria-label="{{ 'Pages'|t('alt-monitor') }}">
            {% if page.page > 1 %}
                <a class="page-link prev-page" rel="prev" href="{{ url(path, criteria.params({page: page.page - 1 > 1 ? page.page - 1 : null})) }}" title="{{ 'Previous Page'|t('app') }}"></a>
            {% endif %}
            {% if page.page < page.pageCount() %}
                <a class="page-link next-page" rel="next" href="{{ url(path, criteria.params({page: page.page + 1})) }}" title="{{ 'Next Page'|t('app') }}"></a>
            {% endif %}
            <div class="page-info">
                {{ '{first, number}–{last, number} of {total, number}'|t('alt-monitor', {first: page.first(), last: page.last(), total: page.total}) }} {{ noun }}
            </div>
        </nav>
    {% endif %}
{% endmacro %}

{% macro failures(failures) %}
    {% if failures %}
        <div class="readable" role="alert" id="altmonitor-failures">
            <p class="error with-icon">{{ 'These could not be updated:'|t('alt-monitor') }}</p>
            <ul class="bullets">
                {% for failure in failures %}
                    <li><code>{{ failure.key }}</code> — {{ failure.reason }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endmacro %}

{% macro pastEnd(page, criteria, path) %}
    <p class="zilch">
        {{ 'There is no page {page, number}.'|t('alt-monitor', {page: page.page}) }}
        <a href="{{ url(path, criteria.params({page: null})) }}">{{ 'Go to the first page'|t('alt-monitor') }}</a>
    </p>
{% endmacro %}
